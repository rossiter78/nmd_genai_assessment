{
  "Comment": "GenAI document processing pipeline",
  "StartAt": "Preprocess",
  "States": {
    "Preprocess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${preprocess_arn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.preprocess_result",
      "ResultSelector": {
        "document_id.$": "$.Payload.document_id",
        "s3_bucket.$": "$.Payload.s3_bucket",
        "s3_key.$": "$.Payload.s3_key",
        "title.$": "$.Payload.title",
        "content.$": "$.Payload.content",
        "source.$": "$.Payload.source",
        "date.$": "$.Payload.date",
        "status.$": "$.Payload.status"
      },
      "Next": "Classify",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "Classify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${classify_arn}",
        "Payload.$": "$.preprocess_result"
      },
      "ResultPath": "$.classify_result",
      "ResultSelector": {
        "document_type.$": "$.Payload.document_type",
        "confidence.$": "$.Payload.classification_confidence"
      },
      "Next": "Extract",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "ThrottlingException",
            "ServiceUnavailableException",
            "InternalServerException",
            "ModelTimeoutException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "Extract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${extract_arn}",
        "Payload": {
          "document_id.$": "$.preprocess_result.document_id",
          "title.$": "$.preprocess_result.title",
          "content.$": "$.preprocess_result.content",
          "source.$": "$.preprocess_result.source",
          "date.$": "$.preprocess_result.date",
          "document_type.$": "$.classify_result.document_type"
        }
      },
      "ResultPath": "$.extract_result",
      "ResultSelector": {
        "extracted_fields.$": "$.Payload.extracted_fields",
        "confidence.$": "$.Payload.extraction_confidence"
      },
      "Next": "Aggregate",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "ThrottlingException",
            "ServiceUnavailableException",
            "InternalServerException",
            "ModelTimeoutException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "Aggregate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${aggregate_arn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "document_id.$": "$.Payload.document_id",
        "document_type.$": "$.Payload.document_type",
        "status.$": "$.Payload.status"
      },
      "End": true,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "PipelineFailed": {
      "Type": "Fail",
      "ErrorPath": "$.error.Error",
      "CausePath": "$.error.Cause"
    }
  }
}
